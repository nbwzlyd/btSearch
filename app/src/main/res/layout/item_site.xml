<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb"
        android:focusable="false" android:clickable="false"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:id="@+id/tvName" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvInfo" android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?colorOnSurfaceVariant" android:ellipsize="end" android:maxLines="1"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
