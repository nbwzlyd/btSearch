<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:paddingTop="12dp" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/tvTitle" android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvSub" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?colorOnSurfaceVariant" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSites" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp" android:layout_weight="0.9"/>
    <LinearLayout android:gravity="end" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAll"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全选"
            style="@style/Widget.Material3.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnNone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清空"
            style="@style/Widget.Material3.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOk"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="确定"/>
    </LinearLayout>
</LinearLayout>
